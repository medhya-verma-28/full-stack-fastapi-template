{
  "http-request": {
    "method": "PATCH",
    "path": "/api/v1/users/me/password",
    "headers": {
"Authorization": "Bearer {{OAUTH2_BEARER_TOKEN}}",      "Content-Type": "application/json"
    },
    "body": {
      "current_password": "changethis",
      "new_password": "short"
    }
  },
  "http-response": {
    "status": 422,
    "headers": {
"Authorization": "Bearer {{OAUTH2_BEARER_TOKEN}}",      "Content-Type": "application/json"
    },
    "body": {
      "detail": [
        {
          "loc": [
            "body",
            "new_password"
          ],
          "msg": "String should have at least 8 characters",
          "type": "string_too_short"
        }
      ]
    }
  }
}
