{
  "http-request": {
    "method": "POST",
    "path": "/api/v1/reset-password/",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "token": "${RESET_TOKEN:test-reset-token}",
      "new_password": "NewStrongPass1"
    }
  },
  "http-response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "message": "Password updated successfully"
    }
  }
}
