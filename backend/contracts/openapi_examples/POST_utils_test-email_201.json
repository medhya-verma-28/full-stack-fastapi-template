{
  "http-request": {
    "method": "POST",
    "path": "/api/v1/utils/test-email/",
    "headers": {
      "Authorization": "Bearer {{OAUTH2_BEARER_TOKEN}}" 
    },
    "query": {
      "email_to": "recipient@example.com"
    }
  },
  "http-response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "message": "Test email sent"
    }
  }
}
