{
    "http-request": {
        "path": "/api/v1/reset-password/",
        "method": "POST",
        "headers": {
            "Accept": "application/json",
            "Content-Type": "application/json"
        },
        "body": {
            "token": "password-reset-token-from-email",
            "new_password": "new-secret-password"
        }
    },
    "http-response": {
        "status": 400,
        "body": {
            "detail": "Invalid token"
        },
        "status-text": "Bad Request",
        "headers": {
            "content-type": "application/json"
        }
    }
}