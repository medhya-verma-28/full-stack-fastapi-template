{
    "http-request": {
        "path": "/api/v1/users/",
        "method": "POST",
        "headers": {
            "Accept": "application/json",
            "Content-Type": "application/json"
        },
        "body": {
            "email": "new.user@example.com",
            "password": "strong-password"
        }
    },
    "http-response": {
        "status": 401,
        "body": {
            "detail": "Not authenticated"
        },
        "status-text": "Unauthorized",
        "headers": {
            
            "content-type": "application/json"
        }
    }
}