{
    "http-request": {
        "path": "/api/v1/users",
        "method": "POST",
        "headers": {
            "Accept": "application/json",
            "Content-Type": "application/json"
        },
        "body": {
            "email": "unique.user.999@example.com",
            "password": "Password@4478",
            "full_name": "Robert Johnson"
        }
    },
    "http-response": {
        "status": 400,
        "body": {
            "detail": "The user with this email already exists in the system."
        },
