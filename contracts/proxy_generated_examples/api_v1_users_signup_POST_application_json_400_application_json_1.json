{
    "http-request": {
        "path": "/api/v1/users/signup",
        "method": "POST",
        "headers": {
            "Content-Type": "application/json",
            "Accept": "application/json",
            "Connection": "close"
        },
        "body": {
            "email": "admin@example.com",
            "password": "changethis",
            "full_name": "Alice Smith",
            "is_verified": true
        }
    },
    "http-response": {
        "status": 400,
        "body": {
            "detail": "The user with this email already exists in the system"
        },
