{
  "http-request": {
    "path": "/api/v1/reset-password/",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json",
      "Accept": "application/json",
      "Authorization": "Bearer {{OAUTH2_BEARER_TOKEN}}"
    },
    "body": {
      "token": "Bearer {{OAUTH2_BEARER_TOKEN}}",
      "new_password": "NewPassword@8582"
    }
  }
}